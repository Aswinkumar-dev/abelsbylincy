# ----------------------------------------------------------------------
# Abel's By Lincy - Hostinger Server Configuration
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Redirect www to non-www (canonicalize to https://abelsbylincy.com.au)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # 2. Force HTTPS secure connection (required for Stripe checkout & trust)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
    # 3. Maintenance Mode (Temporary Redirect)
    # Only apply maintenance mode if it is not localhost (keep local site working)
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
    # Do not redirect backend api requests
    RewriteCond %{REQUEST_URI} !^/api/ [NC]
    # Do not redirect when requesting the maintenance page itself
    RewriteCond %{REQUEST_URI} !/maintenance\.html$ [NC]
    # Do not redirect static assets (so styles, logo, etc. load correctly if needed)
    RewriteCond %{REQUEST_URI} !^/assets/ [NC]
    # Redirect to maintenance.html
    RewriteRule ^(.*)$ /maintenance.html [R=302,L]

    # 4. Pretty URLs: Hiding the .html extension (optional, commented out by default)
    # Uncomment the following lines if you wish to serve pages without .html extensions
    # (e.g. abelsbylincy.com.au/about instead of abelsbylincy.com.au/about.html)
    # Note: If enabled, ensure links in code are also updated.
    # RewriteCond %{REQUEST_FILENAME} !-d
    # RewriteCond %{REQUEST_FILENAME}\.html -f
    # RewriteRule ^([^/]+)$ $1.html [L]

    # 5. Custom 404 handler
    # Serve our brand-aligned 404 error page for all broken links
    ErrorDocument 404 /404.html
</IfModule>

# ----------------------------------------------------------------------
# Performance Optimization: Leverage Browser Caching
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Do not cache dynamic HTML pages
    ExpiresByType text/html "access plus 0 seconds"
    
    # Cache static stylesheets and script code
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/x-javascript "access plus 1 week"
    
    # Cache SVGs & images
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
